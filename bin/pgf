#!/usr/bin/env bash
set -euo pipefail

resolve() {
  local path="$1" dir
  while [[ -L "$path" ]]; do
    dir="$(cd -P "$(dirname "$path")" && pwd)"
    path="$(readlink "$path")"
    [[ "$path" == /* ]] || path="$dir/$path"
  done
  printf '%s\n' "$path"
}

self="$(resolve "${BASH_SOURCE[0]}")"
here="$(cd -P "$(dirname "$self")" && pwd)"
self="$here/$(basename "$self")"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/pgf"
user_dir="${PGF_QUERIES:-$config_dir/queries}"
connections_dir="${PGF_CONNECTIONS:-$config_dir/connections}"
home_services="${PGSERVICEFILE:-$HOME/.pg_service.conf}"
builtin_dir="${PGF_BUILTIN_QUERIES:-}"
if [[ -z "$builtin_dir" ]]; then
  for candidate in "$here/../share/pgf/queries" "$here/../queries"; do
    if [[ -d "$candidate" ]]; then
      builtin_dir="$(cd "$candidate" && pwd)"
      break
    fi
  done
fi

die() {
  printf 'pgf: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found in PATH"
}

find_psql() {
  local dir
  command -v psql >/dev/null 2>&1 && return 0
  for dir in \
    "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/libpq/bin" \
    /opt/homebrew/opt/libpq/bin \
    /usr/local/opt/libpq/bin \
    /opt/homebrew/opt/postgresql@*/bin \
    /usr/local/opt/postgresql@*/bin \
    /usr/lib/postgresql/*/bin \
    /usr/pgsql-*/bin \
    /Applications/Postgres.app/Contents/Versions/latest/bin; do
    if [[ -x "$dir/psql" ]]; then
      PATH="$dir:$PATH"
      return 0
    fi
  done
  die "psql not found; install the PostgreSQL client (libpq or postgresql-client)"
}

use_pager() {
  if [[ -z "${PSQL_PAGER:-}" ]] && command -v pspg >/dev/null 2>&1; then
    export PSQL_PAGER=pspg
  fi
}

pretty_path() {
  if [[ "$1" == "$HOME"/* ]]; then
    printf '%s/%s\n' "~" "${1#"$HOME"/}"
  else
    printf '%s\n' "$1"
  fi
}

usage() {
  cat <<EOF
usage: pgf [command] [args]

  pgf                      pick a connection and open psql
  pgf <service>            open psql for that connection
  pgf q [service] [query]  pick a connection and a saved query, run it
  pgf ls                   list saved queries
  pgf services             list connections and the file each comes from
  pgf edit [query]         edit a query in $user_dir

connections are read in this order, the first one with a name wins:
  .pg_service.conf in the current directory or any parent
  $connections_dir/*.conf
  $home_services
  \$PGSYSCONFDIR/pg_service.conf
EOF
}

project_files() {
  local dir="$PWD"
  while :; do
    if [[ -r "$dir/.pg_service.conf" ]]; then
      printf '%s\n' "$dir/.pg_service.conf"
    fi
    [[ "$dir" == / ]] && break
    dir="$(dirname "$dir")"
  done
}

service_files() {
  local file
  {
    project_files
    if [[ -d "$connections_dir" ]]; then
      for file in "$connections_dir"/*.conf; do
        if [[ -r "$file" ]]; then
          printf '%s\n' "$file"
        fi
      done
    fi
    if [[ -r "$home_services" ]]; then
      printf '%s\n' "$home_services"
    fi
    if [[ -n "${PGSYSCONFDIR:-}" && -r "$PGSYSCONFDIR/pg_service.conf" ]]; then
      printf '%s\n' "$PGSYSCONFDIR/pg_service.conf"
    fi
  } | awk '!seen[$0]++'
}

service_table() {
  local file
  service_files | while IFS= read -r file; do
    awk -v file="$file" '
      /^[[:space:]]*\[/ { name = $0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", name); print name "\t" file }
    ' "$file"
  done | awk -F '\t' '!seen[$1]++'
}

services() {
  local name file
  service_table | while IFS=$'\t' read -r name file; do
    printf '%s\t%s\n' "$name" "$(pretty_path "$file")"
  done
}

service_file() {
  service_table | awk -F '\t' -v want="$1" '$1 == want { print $2; exit }'
}

service_info() {
  local file
  file="$(service_file "$1")"
  [[ -n "$file" ]] || return 0
  printf 'from %s\n\n' "$(pretty_path "$file")"
  awk -v want="$1" '
    /^[[:space:]]*\[/ { current = $0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", current); next }
    current == want && NF && $0 !~ /^[[:space:]]*[#;]/ && $0 !~ /^[[:space:]]*password[[:space:]]*=/ {
      sub(/^[[:space:]]+/, "")
      print
    }
  ' "$file"
}

use_service() {
  local file
  file="$(service_file "$1")"
  [[ -n "$file" ]] || die "no connection named $1, see pgf services"
  export PGSERVICEFILE="$file"
}

queries() {
  local dir file
  for dir in "$user_dir" "$builtin_dir"; do
    [[ -n "$dir" && -d "$dir" ]] || continue
    for file in "$dir"/*.sql; do
      [[ -e "$file" ]] || continue
      basename "$file" .sql
    done
  done | awk '!seen[$0]++' | sort
}

query_path() {
  local dir
  for dir in "$user_dir" "$builtin_dir"; do
    if [[ -n "$dir" && -f "$dir/$1.sql" ]]; then
      printf '%s\n' "$dir/$1.sql"
      return 0
    fi
  done
  return 1
}

query_vars() {
  grep -oE ":'[A-Za-z_][A-Za-z0-9_]*'|:\"[A-Za-z_][A-Za-z0-9_]*\"" "$1" |
    sed -E "s/^:['\"]//; s/['\"]$//" |
    awk '!seen[$0]++' || true
}

query_preview() {
  local file vars
  file="$(query_path "$1")" || return 0
  vars="$(query_vars "$file" | paste -sd ' ' -)"
  if [[ -n "$vars" ]]; then
    printf 'asks for: %s\n\n' "$vars"
  fi
  if command -v bat >/dev/null 2>&1; then
    bat --plain --color=always --language=sql "$file"
  else
    cat "$file"
  fi
}

pick_service() {
  local list
  need fzf
  list="$(services)"
  [[ -n "$list" ]] || die "no connections found, see pgf --help"
  printf '%s\n' "$list" |
    fzf --prompt='connection> ' --delimiter=$'\t' --with-nth=1 \
      --preview="$self __service {1}" --preview-window=right,50% |
    cut -f1
}

pick_query() {
  local list
  need fzf
  list="$(queries)"
  [[ -n "$list" ]] || die "no queries in $user_dir or the built-in set"
  printf '%s\n' "$list" | fzf --prompt='query> ' --preview="$self __query {}" --preview-window=right,60%
}

connect() {
  find_psql
  use_pager
  use_service "$1"
  exec psql "service=$1"
}

run_query() {
  local service="$1" name="$2" file var value
  local -a args=()
  find_psql
  use_pager
  file="$(query_path "$name")" || die "no query named $name"
  use_service "$service"
  while IFS= read -r var; do
    [[ -n "$var" ]] || continue
    printf '%s: ' "$var" >/dev/tty
    IFS= read -r value </dev/tty
    args+=(-v "$var=$value")
  done < <(query_vars "$file")
  exec psql "service=$service" ${args[@]+"${args[@]}"} -f "$file"
}

edit_query() {
  local name="${1:-}" target origin
  if [[ -z "$name" ]]; then
    name="$(pick_query)" || exit 0
  fi
  target="$user_dir/$name.sql"
  mkdir -p "$user_dir"
  if [[ ! -e "$target" ]] && origin="$(query_path "$name")"; then
    cp "$origin" "$target"
    chmod u+w "$target"
  fi
  exec "${VISUAL:-${EDITOR:-vi}}" "$target"
}

main() {
  local command="${1:-}" service query
  case "$command" in
    "")
      service="$(pick_service)" || exit 0
      [[ -n "$service" ]] || exit 0
      connect "$service"
      ;;
    q | query)
      service="${2:-}"
      query="${3:-}"
      if [[ -z "$service" ]]; then
        service="$(pick_service)" || exit 0
        [[ -n "$service" ]] || exit 0
      fi
      if [[ -z "$query" ]]; then
        query="$(pick_query)" || exit 0
      fi
      run_query "$service" "$query"
      ;;
    ls | list) queries ;;
    services) services ;;
    edit) edit_query "${2:-}" ;;
    -h | --help | help) usage ;;
    __service) service_info "${2:-}" ;;
    __query) query_preview "${2:-}" ;;
    -*) die "unknown option $command, see pgf --help" ;;
    *) connect "$command" ;;
  esac
}

main "$@"
